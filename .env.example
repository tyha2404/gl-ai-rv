GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_personal_access_token

# 9Router AI Gateway Configuration (Auto-fallback & multi-provider proxy)
NINE_ROUTER_URL=http://localhost:20128/v1/
NINE_ROUTER_API_KEY=9router-local
NINE_ROUTER_MODEL=auto
NINE_ROUTER_EMBEDDING_MODEL=embedding-3

# AI Review Strategy:
# 'unified' (Khuyên dùng cho Model Free / 1 RPM: 1 request duy nhất bao quát 4 vai trò)
# 'multi_agent' (Nhiều agent chuyên sâu tuần tự qua hàng đợi Rate Limit)
REVIEW_STRATEGY=unified

# Rate Limit & Retry Settings (ms)
AI_REQUEST_DELAY_MS=2000
AI_MAX_RETRIES=3
AI_RETRY_INITIAL_DELAY_MS=5000

# OpenCode Settings (Khởi chạy OpenCode CLI trên VPS để phân tích toàn repo)
USE_OPENCODE=true
OPENCODE_BIN=opencode
OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free
OPENCODE_TIMEOUT_MS=300000

# Claude Code CLI (review 2 pass: tìm lỗi + phản biện; chỉ finding đã kiểm chứng mới được báo)
USE_CLAUDE=true
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
# Mức suy luận của Claude: low|medium|high|xhigh|max (cao hơn = khắt khe, đào sâu logic hơn nhưng chậm/tốn hơn)
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MS=600000
# CLAUDE_MAX_BUDGET_USD=2
# Mặc định true: khi Claude lỗi thì fallback sang OpenCode/AIClient (agent free, có cảnh báo độ tin cậy thấp).
# false = chỉ báo lỗi về Google Chat, không fallback.
CLAUDE_FALLBACK=true

# Đăng thẳng comment BUG/CRITICAL lên GitLab MR (token cần scope `api`). false = chỉ gửi Google Chat.
GITLAB_COMMENTS_ENABLED=true

# Bộ nhớ dự án: Claude tự khám phá nghiệp vụ và tích luỹ kiến thức qua mỗi lần review (1 file markdown/project)
KNOWLEDGE_ENABLED=true
# Nên đặt ngoài thư mục source để deploy không xóa mất. Mặc định: ~/gl-ai-reviewer-knowledge
# KNOWLEDGE_DIR=/home/user/gl-ai-reviewer-knowledge
KNOWLEDGE_MAX_CHARS=12000
CLAUDE_LEARN_TIMEOUT_MS=600000

PORT=3000
GOOGLE_CHAT_WEBHOOK_URL=your_google_chat_webhook_url
